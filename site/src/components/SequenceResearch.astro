---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArchitectureLink from './ArchitectureLink.astro';
import SiteNavigation from './SiteNavigation.astro';
import SequenceEvidence from './SequenceEvidence.astro';
import CryptoSummary from './CryptoSummary.astro';
import fixture from '../data/sequence-synthetic.v1.json';
import { validateSequenceSummary } from '../lib/sequence-summary.ts';
import en from '../i18n/sequence-en.json';
import zh from '../i18n/sequence-zh-CN.json';
import researchEn from '../i18n/sequence-research-en.json';
import researchZh from '../i18n/sequence-research-zh-CN.json';
const locale=Astro.props.locale==='zh-CN'?'zh-CN':'en';
const t=locale==='en'?en:zh;
const data=validateSequenceSummary(fixture);
const names=t.names as Record<string,string>;
---
<SiteLayout locale={locale} localePath="research/lstm-moe/" title={`${t.title} | QUANT / LAB`} description={t.intro}>
 <SiteNavigation locale={locale} active="markets" />
 <main class="sequence-research" data-sequence>
  <header><p class="eyebrow">{t.stage}</p><h1>{t.title}</h1><p class="lead">{t.intro}</p></header>
  <ArchitectureLink locale={locale} />
  <p>{t.migration} <a href="https://github.com/runchengxie/moe-lstm">{t.old} ↗</a></p>
  <SequenceEvidence locale={locale} />
  <CryptoSummary locale={locale} />
  <h2>{(locale==='en'?researchEn:researchZh).syntheticHeading}</h2>
  <p class="notice" role="note">{t.notice}</p>
  <section aria-labelledby="sequence-chart"><h2 id="sequence-chart">{t.chart}</h2>
   <div class="controls" data-synthetic-controls hidden><label>{t.method}<select data-model><option value="all">{Object.values(names).join(' / ')}</option>{data.series.map(s=><option value={s.name}>{names[s.name]}</option>)}</select></label>
    <label>{t.fold}<select><option>1</option></select></label><label>{t.seed}<select><option>11</option></select></label>
   </div>
   <button data-load hidden>{t.load}</button><p data-error hidden>{t.failed}</p>
   <div data-plot hidden role="img" aria-label={t.chart}></div>
   <details open><summary>{t.table}</summary><div class="table-scroll"><table data-synthetic-table><thead><tr><th scope="col">{t.date}</th>{data.series.map(s=><th scope="col">{names[s.name]}</th>)}</tr></thead><tbody>{data.dates.map((d,i)=><tr><th scope="row">{d}</th>{data.series.map(s=><td>{s.values[i].toFixed(3)}</td>)}</tr>)}</tbody></table></div></details>
  </section>
  <p><a href={`https://github.com/runchengxie/global-market-research/blob/main/docs/research/lstm-moe${locale==='zh-CN'?'.zh-CN':''}.md`}>{t.docs} ↗</a> · <a href="https://github.com/runchengxie/global-market-research/tree/main/research/equity-lab">{t.source} ↗</a></p>
  <script type="application/json" data-fixture set:html={JSON.stringify({data,names}).replaceAll('<','\\u003c')} />
 </main>
</SiteLayout>
<script>
 const root=document.querySelector('[data-sequence]');
 const button=root?.querySelector('[data-load]') as HTMLButtonElement;
 const select=root?.querySelector('[data-model]') as HTMLSelectElement;
 const plot=root?.querySelector('[data-plot]') as HTMLElement;
 const payload=JSON.parse(root?.querySelector('[data-fixture]')?.textContent||'{}');
 button.hidden=false;
 (root?.querySelector("[data-synthetic-controls]") as HTMLElement).hidden=false;
 let chart:any;
 function update(){if(chart)chart.setOption({series:payload.data.series.map((s:any)=>({name:payload.names[s.name],type:'line',showSymbol:false,data:select.value==='all'||select.value===s.name?s.values:[]}))});}
 button?.addEventListener('click',async()=>{
  button.disabled=true;
  try {
   const {createSequenceChart}=await import('../scripts/sequence-chart.ts');
   plot.hidden=false;chart=createSequenceChart(plot,payload.data);
   update();const resize=()=>chart.resize();new ResizeObserver(resize).observe(plot);window.addEventListener('resize',resize);button.hidden=true;
  } catch { (root?.querySelector('[data-error]') as HTMLElement).hidden=false;button.disabled=false; }
 });
 select?.addEventListener('change',update);
</script>
<style>
.sequence-research{max-width:1100px;margin:auto;padding:3rem 2rem 5rem}.sequence-research h1{font:400 clamp(2.2rem,4vw,3.8rem)/1.25 Georgia,'SimSun',serif}.sequence-research h2{font:400 1.8rem/1.3 Georgia,'SimSun',serif}.sequence-research p{line-height:1.85;max-width:90ch}.eyebrow{color:var(--green);font-size:.8rem;letter-spacing:.12em}.lead{font-size:1.15rem}.notice{border-left:3px solid var(--green);padding:1rem;background:var(--surface)}section{margin:3rem 0}.controls[hidden],button[hidden]{display:none}.controls{display:flex;flex-wrap:wrap;gap:1rem;margin:1rem 0}label{display:grid;gap:.4rem;min-width:0;max-width:100%}select{min-width:0;width:100%}select,button{font:inherit;padding:.65rem;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:.3rem;max-width:100%}button{cursor:pointer}button:focus-visible,select:focus-visible{outline:2px solid var(--green);outline-offset:3px}[data-plot]{height:420px;width:100%;min-width:0;overflow:hidden;background:#fafaf8;margin:1rem 0}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}td,th{text-align:left;padding:.6rem;border-bottom:1px solid var(--line);white-space:nowrap}details{margin:1rem 0}summary{cursor:pointer}@media(max-width:600px){.sequence-research{padding:1.5rem 1.2rem}.controls{display:grid;grid-template-columns:minmax(0,1fr)} [data-plot]{height:320px}}
</style>
