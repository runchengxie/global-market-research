---
import fixture from '../data/crypto-evidence.v1.json';
import {validateCryptoEvidence,selectCryptoRows,cryptoFinding} from '../lib/crypto-evidence.ts';
import en from '../i18n/crypto-evidence-en.json';
import zh from '../i18n/crypto-evidence-zh-CN.json';
const locale=Astro.props.locale==='zh-CN'?'zh-CN':'en';
const t=locale==='en'?en:zh,data=validateCryptoEvidence(fixture);
const Heading=Astro.props.standalone?'h1':'h2';
const pct=(v:number|null)=>v===null?t.unavailable:new Intl.NumberFormat(locale,{style:'percent',maximumFractionDigits:3}).format(v);
const num=(v:number|null,digits=2)=>v===null?t.unavailable:new Intl.NumberFormat(locale,{maximumFractionDigits:digits}).format(v);
const clock=(s:string)=>new Intl.DateTimeFormat(locale,{timeZone:'UTC',dateStyle:'medium',timeStyle:'medium'}).format(new Date(s));
const prefix=`/global-market-research/${locale==='en'?'':'zh-CN/'}`;
const factorWorse=[1,4].every(step=>{const r=selectCryptoRows(data,step,10);return r.slice(1,4).every(x=>x.skill!==null&&r[0].skill!==null&&x.skill<r[0].skill);});
---
<div class="crypto-evidence" data-crypto-evidence data-real-evidence>
 <header><p class="eyebrow">{t.stage}</p><Heading>{t.title}</Heading><p class="lead">{t.intro}</p><p class="notice" data-crypto-conclusion>{t.findings[cryptoFinding(data)]}</p><p>{factorWorse?t.factorWorse:t.factorMixed}</p><p>{t.flatNote}</p></header>
 <section aria-labelledby="crypto-sample"><h2 id="crypto-sample">{t.sampleTitle}</h2><div class="stat-grid"><article><h3>{t.prices}</h3><p>{t.priceScope.replace('{hours}',num(data.sample.hourly_per_asset)).replace('{four}',num(data.sample.four_hour_per_asset))}</p><p>{t.period}: {data.sample.start.slice(0,10)} → {data.sample.end_exclusive.slice(0,10)} (UTC)</p></article><article><h3>{t.factorTitle}</h3><p>{t.factorScope.replace('{rows}',num(data.sample.factor_rows))}</p><p>{data.sample.factor_indicators.join(' · ')}</p><p>{data.sample.factor_start.slice(0,10)} → {data.sample.factor_end_exclusive.slice(0,10)} (UTC)</p></article></div><p class="notice">{t.factorAvailability}</p><p>{num(data.experiment.fit_count)} {t.fits} · {num(data.experiment.trial_count)} {t.cases}</p></section>
 <section><h2>{t.methodTitle}</h2><p>{t.method}</p><ol><li>{t.timing}</li><li>{t.accounts}</li></ol></section>
 <section><h2>{t.tableTitle}</h2><p>{t.scoreNote}</p>{[1,4].map(step=><div><h3>{step===1?t.oneHour:t.fourHour}</h3><div class="scroll"><table data-crypto-summary={step}><caption>{step===1?t.oneHour:t.fourHour} · {t.tableTitle}</caption><thead><tr>{[t.model,t.skill,t.net,t.exposure,t.turnover,t.drawdown,t.ic].map(x=><th scope="col">{x}</th>)}</tr></thead><tbody>{selectCryptoRows(data,step,10).map(r=><tr data-crypto-arm={r.arm}><th scope="row">{t.arms[r.arm]}</th><td>{pct(r.skill)}</td><td>{pct(r.net_return)}</td><td>{pct(r.exposure)}</td><td>{num(r.turnover)}×</td><td>{pct(r.max_drawdown)}</td><td>{num(r.ic,4)}</td></tr>)}</tbody></table></div></div>)}</section>
 <section><h2>{t.chartTitle}</h2><div class="controls" data-crypto-controls hidden><label>{t.grain}<select data-crypto-grain><option value="4">{t.fourHour}</option><option value="1">{t.oneHour}</option></select></label><label>{t.chartMetric}<select data-crypto-metric>{Object.entries(t.metrics).map(([id,label])=><option value={id}>{label}</option>)}</select></label></div><button data-crypto-load hidden>{t.chartLoad}</button><p data-crypto-error hidden>{t.chartError}</p><div data-crypto-chart hidden role="img" aria-label={t.chartTitle}></div><p class="detail">{t.chartNote}</p></section>
 <details><summary>{t.uncertaintyTitle}</summary><p>{t.uncertainty}</p><div class="scroll"><table data-crypto-intervals><thead><tr>{[t.grain,t.model,t.dailyDifference,t.interval].map(x=><th scope="col">{x}</th>)}</tr></thead><tbody>{data.rows.filter(r=>r.fee_bps===10).map(r=><tr><td>{r.step_hours}h</td><th scope="row">{t.arms[r.arm]}</th><td>{num(r.paired_mean*10000,5)}</td><td>[{r.paired_interval.map(v=>num(v*10000,5)).join(', ')}]</td></tr>)}</tbody></table></div></details>
 <details><summary>{t.foldTitle}</summary><p>{t.foldNote}</p><div class="scroll"><table data-crypto-folds><thead><tr>{[t.grain,t.fold,t.model,t.fee,t.bars,t.skill,t.net,t.exposure,t.drawdown].map(x=><th scope="col">{x}</th>)}</tr></thead><tbody>{data.folds.map(r=><tr><td>{r.step_hours}h</td><td>{r.fold+1}</td><th scope="row">{t.arms[r.arm]}</th><td>{r.fee_bps}</td><td>{num(r.bars)}</td><td>{pct(r.skill)}</td><td>{pct(r.net_return)}</td><td>{pct(r.exposure)}</td><td>{pct(r.max_drawdown)}</td></tr>)}</tbody></table></div></details>
 <section><h2>{t.futureTitle}</h2><p>{t.futureNote}</p><dl class="facts" data-crypto-forward>{[[t.frozen,clock(data.observation.frozen_at)],[t.asOf,clock(data.observation.as_of)],[t.captures,num(data.observation.captures)],[t.observed,num(data.observation.observed_bars)],[t.late,num(data.observation.late_received_bars)],[t.forecasts,num(data.observation.committed_forecasts)],[t.scored,num(data.observation.scored_forecasts)],[t.revisions,num(data.observation.revisions)]].map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><p class="notice">{data.observation.scored_forecasts===0?t.unscored:t.scoredLimit}</p><p>{t.factorBlocked}</p></section>
 <section><h2>{t.opsTitle}</h2><p>{t.health[data.operations.health_status as keyof typeof t.health]}</p><dl class="facts">{[[t.http,`${data.operations.http_attempts}/${data.operations.http_limit}`],[t.transfer,`${num(data.operations.transfer_bytes)}/${num(data.operations.transfer_limit)}`],[t.fitBudget,`${data.experiment.fit_count}/${data.operations.fit_limit}`],[t.observationHttp,`${data.operations.observation_http_attempts}/${data.operations.observation_http_limit}`],[t.reserved,num(data.operations.reserved_unknown_bytes)]].map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><p>{t.opsNote}</p></section>
 <details><summary>{t.provenance}</summary><p>{t.privacy}</p><ul><li><a href={`https://github.com/runchengxie/global-market-research/blob/main/docs/research/crypto-evidence${locale==='zh-CN'?'.zh-CN':''}.md`}>{t.sourceDocs} ↗</a></li><li><a href="https://github.com/runchengxie/global-market-research/blob/main/site/src/data/crypto-evidence.v1.json">{t.sourceData} ↗</a></li>{Object.entries(data.sources).filter(([,value])=>value!==null).map(([key,value])=><li>{t.sourceLabels[key as keyof typeof t.sourceLabels]}: {key.endsWith('_revision')?<a href={`https://github.com/runchengxie/global-market-research/tree/${value}`}><code>{value}</code></a>:<code>{value}</code>}</li>)}</ul></details>
 {!Astro.props.standalone&&<p><a href={`${prefix}research/crypto-evidence/`}>{t.openPage} →</a></p>}
 <script type="application/json" data-crypto-config set:html={JSON.stringify({data,t,locale}).replaceAll('<','\\u003c')} />
</div>
<script>
 import {mountCryptoEvidence} from '../scripts/crypto-evidence.ts';
 document.querySelectorAll<HTMLElement>('[data-crypto-evidence]').forEach(mountCryptoEvidence);
</script>
<style>
.crypto-evidence{min-width:0}.crypto-evidence header,.crypto-evidence section{margin:2.5rem 0}.crypto-evidence h1{font:400 clamp(2rem,4vw,3.3rem)/1.3 Georgia,'SimSun',serif}.crypto-evidence h2{font:400 clamp(1.5rem,3vw,2rem)/1.4 Georgia,'SimSun',serif}.crypto-evidence h3{font-size:1.1rem}.crypto-evidence p,.crypto-evidence li{line-height:1.9;max-width:95ch}.eyebrow{font-size:.8rem;letter-spacing:.08em;color:var(--green)}.lead{font-size:1.1rem}.notice{background:var(--surface);border-left:3px solid var(--green);padding:1rem 1.2rem}.stat-grid,.controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.4rem}.stat-grid article{border:1px solid var(--line);padding:1.2rem}.scroll{overflow-x:auto;max-width:100%;margin:1rem 0}table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums;font-size:.87rem}th,td{padding:.7rem;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}caption{text-align:left;padding:.5rem 0;color:var(--muted)}label{display:grid;gap:.4rem;min-width:0}select,button{font:inherit;min-width:0;max-width:100%;background:var(--surface);color:var(--ink);border:1px solid var(--line);padding:.7rem;border-radius:.25rem}select{width:100%}button{margin:1rem 0;cursor:pointer}select:focus-visible,button:focus-visible{outline:2px solid var(--green);outline-offset:3px}[hidden]{display:none!important}[data-crypto-chart]{height:420px;width:100%;min-width:0;overflow:hidden;margin:1rem 0}.detail{color:var(--muted);font-size:.9rem}details{margin:2rem 0}summary{font-weight:600;cursor:pointer}.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.facts div{border-top:1px solid var(--line);padding-top:.6rem}.facts dt{color:var(--muted);font-size:.85rem}.facts dd{margin:.35rem 0;font-variant-numeric:tabular-nums}code{overflow-wrap:anywhere;font-size:.8rem}@media(max-width:650px){.stat-grid,.controls,.facts{grid-template-columns:minmax(0,1fr)}[data-crypto-chart]{height:390px}.crypto-evidence header,.crypto-evidence section{margin:2rem 0}}
</style>
