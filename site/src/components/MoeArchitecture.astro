---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavigation from './SiteNavigation.astro';
import {example,memoryStep,SCENARIOS} from '../lib/moe-story';
import en from '../i18n/moe-story-en.json';
import zh from '../i18n/moe-story-zh-CN.json';
const locale=Astro.props.locale==='zh-CN'?'zh-CN':'en',t=locale==='en'?en:zh;
const prefix=`/global-market-research/${locale==='en'?'':'zh-CN/'}`;
const data=example('dense',0),memory=memoryStep(0,0,4);
const pct=(x:number)=>new Intl.NumberFormat(locale,{style:'percent',maximumFractionDigits:1}).format(x);
const num=(x:number)=>new Intl.NumberFormat(locale,{maximumFractionDigits:2,signDisplay:'exceptZero'}).format(x);
const letters=['A','B','C'];
---
<SiteLayout locale={locale} localePath="research/moe-architecture/" title={`${t.subtitle} | QUANT / LAB`} description={t.intro}>
 <SiteNavigation locale={locale} active="markets" />
 <main class="moe-topic" data-moe-story data-mode="dense" data-step="9" data-phase="overview" data-day="4" data-motion="paused">
  <header class="hero"><a class="back" href={`${prefix}markets/`}>← {t.back}</a><p class="eyebrow">{t.subtitle}</p><h1>{t.title}</h1><p class="intro">{t.intro}</p><p class="notice" role="note">{t.notice}</p></header>
  <div class="story-stage">
  <div class="story-controls" data-story-controls hidden>
   <div class="choices"><label>{t.modeLabel}<select data-mode>{Object.entries(t.modes).map(([id,label])=><option value={id}>{label}</option>)}</select></label><label>{t.scenarioLabel}<select data-scenario>{t.scenarios.map((label,i)=><option value={i}>{label}</option>)}</select></label></div>
   <div class="transport"><button data-play aria-pressed="false">{t.play}</button><button data-previous>{t.previous}</button><button data-next>{t.next}</button><button data-restart>{t.restart}</button><span data-counter></span></div>
   <ol class="progress">{Array.from({length:10},(_,i)=><li><button data-jump={i} aria-label={t.stepCounter.replace('{current}',String(i+1)).replace('{total}','10')}>{i+1}</button></li>)}</ol>
   <p class="motion-note" data-motion-note>{t.manualNote}</p>
  </div>
  <section class="scene" aria-labelledby="scene-caption">
   <div class="caption"><span class="chapter-index" data-chapter-index>10</span><div><h2 id="scene-caption" data-caption-title>{t.captions.output.title}</h2><p data-caption>{t.captions.output.body}</p></div></div>
   <p class="sr-only" aria-live="polite" aria-atomic="true" data-announcement></p>
   <figure class="diagram" data-diagram aria-label={t.diagramLabel}>
    <div class="window-panel"><h3>{t.window}</h3><div class="days">{SCENARIOS[0].changes.map((change,i)=><div class="day" data-story-day={i}><span>{t.timeLabel.replace('{day}',String(i+1))}</span><strong data-change>{num(change)}%</strong><small>{t.changeLabel}</small></div>)}</div><p>{t.windowNote}</p></div>
    <div class="router-strip"><div class="router-token" data-router><span class="router-symbol" aria-hidden="true">↗</span><div><h3 data-router-title>{t.router}</h3><p data-router-note>{t.routerNote}</p></div></div></div>
    <svg class="wiring" viewBox="0 0 720 54" aria-hidden="true" preserveAspectRatio="none"><path d="M360 0 V12 Q360 24 345 24 H135 Q120 24 120 40 V54" data-flow-in="0"/><path d="M360 0 V54" data-flow-in="1"/><path d="M360 0 V12 Q360 24 375 24 H585 Q600 24 600 40 V54" data-flow-in="2"/></svg>
    <div class="experts">{letters.map((letter,i)=><article class={`expert expert-${i}`} data-story-expert={i} data-active="true"><div class="expert-top"><span class="expert-name">{t.expert.replace('{letter}',letter)}</span><span class="expert-kind">LSTM</span></div><svg class="lstm-glyph" viewBox="0 0 160 60" aria-hidden="true"><path class="memory-loop" d="M20 32 H134 Q149 32 149 17 Q149 4 134 4 H34 Q20 4 20 17 V44 Q20 55 34 55 H92"/><rect x="50" y="17" width="60" height="30" rx="8"/><path d="M59 26 H83 M59 34 H96"/></svg><p class="expert-status" data-expert-status>{t.complete}</p><div class="weight-line"><span>{t.weight}</span><strong data-weight>{pct(data.weights[i])}</strong></div><div class="weight-track"><span data-weight-bar style={`width:${data.weights[i]*100}%`}></span></div><p class="expert-notes"><span>{t.notes}</span><code data-notes>[{data.representations[i].map(num).join(', ')}, …]</code></p><button class="lens-button" data-expert-lens={i} hidden>{t.lensButton.replace('{letter}',letter)}</button></article>)}</div>
    <p class="expert-footnote">{t.expertNote} {t.notesNote}</p>
    <svg class="wiring output-wiring" viewBox="0 0 720 54" aria-hidden="true" preserveAspectRatio="none"><path d="M120 0 V14 Q120 28 135 28 H345 Q360 28 360 42 V54" data-flow-out="0"/><path d="M360 0 V54" data-flow-out="1"/><path d="M600 0 V14 Q600 28 585 28 H375 Q360 28 360 42 V54" data-flow-out="2"/></svg>
    <div class="mix-panel" data-mix><span class="stage-mark" aria-hidden="true">Σ</span><div><h3>{t.mix}</h3><p>{t.mixNote}</p><code data-mixture>[{data.mixture.map(num).join(', ')}, …]</code></div></div>
    <div class="head-connector" aria-hidden="true">↓</div>
    <div class="head-panel" data-head><div><h3>{t.head}</h3><p>{t.headNote}</p></div><div class="score"><span>{t.toyScore}</span><strong data-output>{num(data.score)}</strong></div></div>
    <figcaption>{t.notice}</figcaption>
   </figure>
  </section>
  </div>
  <section class="memory-lens" aria-labelledby="memory-title"><div class="lens-heading"><p class="eyebrow">LSTM · <span data-lens-name>{t.expert.replace('{letter}','A')}</span></p><h2 id="memory-title">{t.lensTitle}</h2><p>{t.lensNote}</p></div><div class="lens-steps" data-lens-controls hidden><span>{t.lensSteps}</span>{Array.from({length:5},(_,i)=><button data-lens-jump={i}>{t.timeLabel.replace('{day}',String(i+1))}</button>)}</div><p data-memory-prompt>{t.timeLabel.replace('{day}','5')}</p><div class="gates">{[['forget',t.keep,t.keepNote],['write',t.write,t.writeNote],['output',t.readout,t.readoutNote]].map(([key,label,note])=><article><h3>{label}</h3><div class="gate-meter"><span data-gate-bar={key} style={`width:${memory[key as 'forget'|'write'|'output']*100}%`}></span></div><strong data-gate-value={key}>{pct(memory[key as 'forget'|'write'|'output'])}</strong><p>{note}</p></article>)}</div><div class="memory-state">{[['previous',t.oldMemory],['cell',t.newMemory],['hidden',t.representation]].map(([key,label])=><div><span>{label}</span><strong data-memory-value={key}>{num(memory[key as 'previous'|'cell'|'hidden'])}</strong></div>)}</div><details><summary>{t.technicalTitle}</summary><p>{t.formula}</p><p>{t.technical}</p></details></section>
  <section class="explanations"><h2>{t.whyTitle}</h2><div class="mode-cards">{['whyDense','whyEqual','whySparse'].map(k=><p>{t[k as 'whyDense']}</p>)}</div><p>{t.whyNote}</p><h2>{t.staticTitle}</h2><ol data-static-steps>{t.staticSteps.map(step=><li>{step}</li>)}</ol><noscript><p>{t.nojs}</p></noscript></section>
  <section class="research-links"><h2>{t.researchTitle}</h2><a href={`${prefix}research/lstm-moe/`}>{t.stockLink} →</a><a href={`${prefix}research/crypto-evidence/`}>{t.cryptoLink} →</a><a href={`${prefix}research/crypto-cnn/`}>{t.cnnLink} →</a><p>{t.cnnNote}</p></section>
  <script type="application/json" data-moe-config set:html={JSON.stringify({t,locale}).replaceAll('<','\\u003c')} />
 </main>
</SiteLayout>
<script>import {mountMoeStory} from '../scripts/moe-story';document.querySelectorAll<HTMLElement>('[data-moe-story]').forEach(mountMoeStory);</script>
<style>
.moe-topic{max-width:1040px;margin:auto;padding:2.5rem 2rem 5rem;color:var(--ink)}.hero{max-width:850px}.back{color:var(--green);font-size:.85rem;text-underline-offset:4px}.eyebrow{color:var(--green);font-size:.8rem;font-weight:600;letter-spacing:.05em;margin:1.4rem 0 .6rem}h1{font:400 clamp(2.1rem,5vw,4rem)/1.22 Georgia,'SimSun',serif;margin:.4rem 0 1rem}h2{font:400 clamp(1.35rem,2.3vw,1.8rem)/1.4 Georgia,'SimSun',serif}h3{font-size:1rem;margin:0;line-height:1.5}p{line-height:1.85}.intro{font-size:1.12rem;max-width:75ch}.notice{font-size:.85rem;border-left:3px solid var(--green);padding:.7rem 1rem;background:var(--surface);max-width:85ch}.story-controls{display:contents}.choices{margin-top:2rem;display:grid;grid-template-columns:1fr 1fr;gap:1rem;max-width:750px}label{display:grid;gap:.4rem;font-size:.85rem;min-width:0}select,button{font:inherit;color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:7px;padding:.6rem .8rem;max-width:100%}select{width:100%;min-width:0}button{cursor:pointer}button:disabled{opacity:.45;cursor:default}button:focus-visible,select:focus-visible,a:focus-visible{outline:2px solid var(--green);outline-offset:3px}.transport{position:sticky;top:0;z-index:6;background:var(--paper);padding:.6rem 0;border-bottom:1px solid var(--line);display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;margin:1rem 0}[data-play]{background:var(--green);color:var(--button-ink);border-color:var(--green);min-width:5rem}[data-counter]{font-size:.8rem;margin-left:auto;font-variant-numeric:tabular-nums}.progress{list-style:none;display:flex;gap:.45rem;flex-wrap:wrap;padding:0;margin:1rem 0}.progress button{border-radius:50%;height:2rem;width:2rem;padding:0;font-size:.8rem}.progress [aria-current=step]{background:var(--ink);color:var(--paper);border-color:var(--ink)}.motion-note{font-size:.8rem;opacity:.8}.caption{display:flex;gap:1rem;align-items:flex-start;min-height:140px}.caption h2{margin:0 0 .3rem}.caption p{margin:0;max-width:75ch;font-size:.95rem}.chapter-index{font-size:1rem;display:grid;place-items:center;flex:0 0 2.3rem;height:2.3rem;border-radius:50%;border:1px solid var(--line);color:var(--green);font-variant-numeric:tabular-nums}.diagram{margin:0;padding:1.5rem;border:1px solid var(--line);border-radius:18px;background:var(--surface);overflow:hidden;min-width:0;scroll-margin-top:110px}.window-panel h3{text-align:center}.days{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.6rem;margin:1rem 0}.day{display:grid;gap:.25rem;text-align:center;border:1px solid var(--line);border-radius:8px;padding:.7rem .2rem;background:var(--paper);transition:transform .35s,border-color .35s,background-color .35s}.day span,.day small{font-size:.7rem;opacity:.75}.day strong{font-size:1.15rem;font-variant-numeric:tabular-nums}.day[data-current=true]{border-color:var(--green);transform:translateY(-4px);box-shadow:0 5px 14px color-mix(in srgb,var(--green) 15%,transparent)}.window-panel>p,.expert-footnote{font-size:.75rem;text-align:center;margin:.6rem 0;opacity:.8}.router-strip{display:flex;justify-content:center;margin-top:1rem}.router-token{display:flex;align-items:center;gap:.75rem;border:1px solid var(--line);border-radius:10px;padding:.7rem 1rem;background:var(--paper);max-width:600px;transition:border-color .3s}.router-token p{font-size:.8rem;margin:.1rem 0}.router-symbol{font-size:2rem;color:var(--green)}.wiring{display:block;width:100%;height:50px;overflow:visible}.wiring path{fill:none;stroke:var(--line);stroke-width:2;vector-effect:non-scaling-stroke}.wiring path[data-active=true]{stroke:var(--green);stroke-dasharray:7 9}.experts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.expert{--accent:var(--green);border:1px solid var(--line);border-radius:12px;padding:1rem;background:var(--paper);transition:opacity .3s,border-color .3s,box-shadow .3s;min-width:0}.expert-1{--accent:#be8426}.expert-2{--accent:#8b79cc}.expert[data-active=false]{border-style:dashed;color:var(--muted)}.expert[data-active=false] .lstm-glyph{opacity:.35}.expert[data-reading=true]{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 10%,transparent)}.expert-top{display:flex;align-items:center;justify-content:space-between;gap:.3rem}.expert-name{font-size:.95rem;font-weight:600}.expert-kind{font:500 .65rem/1.5 monospace;color:var(--ink);padding:.1rem .35rem;border:1px solid var(--line);border-radius:4px}.lstm-glyph{display:block;width:100%;height:64px;margin:.3rem 0}.lstm-glyph path,.lstm-glyph rect{fill:none;stroke:var(--accent);stroke-width:2}.memory-loop{stroke-dasharray:5 7;opacity:.6}.expert-status{font-size:.75rem;margin:.4rem 0;min-height:1.8em}.weight-line{display:flex;justify-content:space-between;font-size:.75rem;gap:.25rem}.weight-track,.gate-meter{height:5px;border-radius:8px;background:var(--line);overflow:hidden;margin:.5rem 0}.weight-track span,.gate-meter span{display:block;height:100%;border-radius:inherit;background:var(--accent,var(--green));transition:width .45s}.expert-notes{font-size:.7rem;margin:.75rem 0}.expert-notes span{display:block;opacity:.75}.expert-notes code{font-size:.78rem;white-space:nowrap}.lens-button{font-size:.7rem;padding:.4rem;width:100%;margin-top:.2rem}.mix-panel{display:flex;align-items:center;gap:1rem;padding:1rem;border:1px solid var(--line);border-radius:10px;background:var(--paper)}.mix-panel p,.head-panel p{font-size:.8rem;margin:.25rem 0}.stage-mark{font-size:2rem;color:var(--green)}.mix-panel code{font-size:.85rem}.head-connector{text-align:center;color:var(--green);font-size:1.6rem;line-height:1.4}.head-panel{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;padding:1rem;border:1px solid var(--line);border-radius:10px;background:var(--paper)}.score{display:grid;gap:.25rem;text-align:center;flex-shrink:0;min-width:100px}.score span{font-size:.7rem}.score strong{font:500 1.8rem/1.3 monospace;color:var(--green)}figcaption{font-size:.7rem;opacity:.8;line-height:1.7;margin-top:1rem}.memory-lens{margin:2rem 0;padding:1.5rem;border:1px solid var(--line);border-radius:16px}.lens-heading h2{margin:.5rem 0}.lens-heading p{font-size:.9rem}.lens-steps{display:flex;gap:.4rem;align-items:center;flex-wrap:wrap}.lens-steps span{font-size:.8rem;width:100%}.lens-steps button{font-size:.8rem;padding:.4rem .6rem}.lens-steps [aria-current=step]{border-color:var(--green);box-shadow:inset 0 -2px var(--green)}.gates{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.gates article{padding:1rem;border:1px solid var(--line);border-radius:9px}.gates h3{font-size:.9rem}.gates p{font-size:.8rem;margin:.5rem 0 0}.gates strong{font-variant-numeric:tabular-nums}.memory-state{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1rem 0}.memory-state div{display:grid;gap:.4rem}.memory-state span{font-size:.8rem}.memory-state strong{font-family:monospace;color:var(--green)}details{margin-top:1rem}summary{cursor:pointer;font-size:.9rem}.explanations,.research-links{margin:2.5rem 0}.mode-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.mode-cards p{font-size:.9rem;border-top:2px solid var(--green);padding-top:.8rem}li{line-height:1.9;padding:.25rem 0}.research-links a{display:block;color:var(--green);padding:.7rem 0;text-underline-offset:4px}.research-links p{font-size:.85rem}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}[data-phase=route] .router-token,[data-phase=mix] .mix-panel,[data-phase=output] .head-panel{border-color:var(--green)}[data-motion=running] .wiring path[data-active=true],[data-motion=running] .expert[data-reading=true] .memory-loop{animation:signal 1s linear infinite}[data-motion=running] .expert[data-reading=true] .lstm-glyph rect{animation:breathe 1.4s ease-in-out infinite}@keyframes signal{to{stroke-dashoffset:-32}}@keyframes breathe{50%{opacity:.35}}
@media(max-width:650px){.moe-topic{padding:1.5rem 1.15rem 3rem}.choices{grid-template-columns:minmax(0,1fr)}.diagram{padding:.8rem}.days{gap:.3rem}.day{padding:.5rem .1rem}.day strong{font-size:.9rem}.day small{font-size:.55rem}.experts{gap:.35rem}.expert{padding:.6rem .4rem;border-radius:8px}.expert-name{font-size:.78rem}.expert-top{flex-wrap:wrap}.expert-kind{font-size:.6rem}.expert-status{font-size:.65rem;min-height:3em}.expert-notes code{font-size:.6rem}.weight-line{font-size:.65rem;flex-wrap:wrap}.lens-button{font-size:.65rem;padding:.4rem .15rem;line-height:1.6}.lstm-glyph{height:50px}.wiring{height:35px}.gates{grid-template-columns:minmax(0,1fr)}.gates article{padding:.8rem}.memory-lens{padding:1rem}.mode-cards{grid-template-columns:minmax(0,1fr);gap:.25rem}.caption{min-height:180px;gap:.6rem}.caption p{font-size:.88rem}.head-panel{gap:.65rem}.head-panel p{font-size:.75rem}.score{min-width:75px}.score strong{font-size:1.4rem}.score span{font-size:.6rem}.memory-state{gap:.5rem}.memory-state span{font-size:.7rem}.transport button{padding:.55rem .6rem;font-size:.82rem}[data-counter]{font-size:.72rem}}
@media(prefers-reduced-motion:reduce){.day,.expert,.router-token,.weight-track span,.gate-meter span{transition:none!important}.moe-topic *{animation:none!important}}
</style>
